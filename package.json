{
  "name": "personal-library",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4330 --strictPort",
    "install:locked": "npm ci --ignore-scripts --no-audit --no-fund",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:gateway": "node --test gateway/local-nli-check.test.mjs",
    "build:gateway": "vite build --config vite.config.gateway.ts",
    "start:gateway": "node .gateway-dist/run.js",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4331 --strictPort",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:gateway && npm run build && npm run build:gateway",
    "test:browser": "playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts",
    "test:performance": "npm run build && playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
